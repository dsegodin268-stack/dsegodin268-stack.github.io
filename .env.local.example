# Supabase — скопіюйте цей файл у .env.local та заповніть значеннями
# з Dashboard → Settings → API вашого Supabase-проєкту.
# Якщо змінні не задані, форма контактів працює в демо-режимі
# (заявки логуються на сервері, але не зберігаються в БД).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
